PORT=5000
# Local: mongodb://127.0.0.1:27017/civicscan
# Atlas: mongodb+srv://<user>:<password>@<cluster>/civicscan
MONGO_URI=mongodb://127.0.0.1:27017/civicscan
JWT_SECRET=replace_with_a_long_random_string
NODE_ENV=development

# Optional: override the model checkpoint the inference service loads
# CIVICSCAN_CKPT=../civicscan_training_rfdetr/training/runs/rfdetr_run4_700px/best.pt
# INFERENCE_SERVICE_URL=http://127.0.0.1:5001/predict
