PORT=5000
# Local: mongodb://127.0.0.1:27017/civicscan
# Atlas: mongodb+srv://<user>:<password>@<cluster>/civicscan
MONGO_URI=mongodb://127.0.0.1:27017/civicscan
JWT_SECRET=replace_with_a_long_random_string
NODE_ENV=development

# Optional: override the model checkpoint the inference service loads
# CIVICSCAN_CKPT=../civicscan_training_rfdetr/training/runs/rfdetr_run4_700px/best.pt
# INFERENCE_SERVICE_URL=http://127.0.0.1:5001/predict

# --- Report-ID e-mail (sent to the citizen when a report is created) ---
# Leave SMTP_* empty to use a free Ethereal TEST inbox: nothing is delivered to real
# addresses, and the server log + upload response give a link to open the email.
# For real delivery set an SMTP account (Brevo, Resend, SendGrid, Gmail app password...):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=CivicScan <no-reply@yourdomain.org>
# Base URL of the frontend, used for the "Track this report" link in the e-mail
# FRONTEND_URL=http://localhost:5173

# --- Verification Agent: a vision LLM double-checks every detection (uses ANTHROPIC_API_KEY) ---
# It sees a resized copy of the photo with ALL metadata removed (no GPS, no email) and can keep,
# relabel or remove each box. Put the real key only in backend/.env, never in code or git.
# ANTHROPIC_API_KEY=your_key_here
# LLM_VERIFY=true                          set false to switch the check off
# LLM_VERIFY_MODE=all                      all = every detection, low = only below the dispatch threshold
# LLM_VERIFY_MODEL=claude-haiku-5-5
# LLM_VERIFY_TIMEOUT_MS=45000
# AUTO_DISPATCH=true
# AUTO_DISPATCH_MIN_CONFIDENCE=0.40

# --- Staff login (Phase 0) ---
# JWT_SECRET above signs the login tokens (at least 16 characters).
# JWT_TTL=8h                         how long a staff login lasts
# Uploaded photos are only served through signed, expiring links:
# SIGNED_UPLOADS=true                set false only while debugging
# UPLOAD_URL_SECRET=                 optional separate signing key (defaults to JWT_SECRET)
# Seed account passwords (otherwise random ones are written to backend/.seed-credentials.local):
# SEED_LITTER_PASSWORD=
# SEED_ROADS_PASSWORD=
# SEED_OFFICER_PASSWORD=

# --- CivicScan Assistant (role-scoped chat agent, uses ANTHROPIC_API_KEY) ---
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=low
